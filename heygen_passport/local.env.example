# Heygen Passport local settings.
# Copy this file to "local.env" in the same folder and edit it.
# local.env stays on the hotel machine: it is excluded from Git, never commit it.

HEYGEN_DB_ENGINE=mssql

# Your local SQL Server instance, for example:
#   localhost                   default instance on this PC
#   localhost\SQLEXPRESS        SQL Server Express named instance
#   HOTEL-SQL01\PROD            another server on the hotel network
HEYGEN_MSSQL_SERVER=localhost\SQLEXPRESS

# The NEW, separate database for Heygen Passport. "init" creates it if missing.
HEYGEN_MSSQL_DATABASE=HeygenPassport

# ODBC driver installed on this machine (check "ODBC Data Sources" in Windows).
HEYGEN_MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# Leave both empty to sign in with Windows authentication (recommended).
# Otherwise use a dedicated SQL login for Heygen, never "sa".
HEYGEN_MSSQL_USER=
HEYGEN_MSSQL_PASSWORD=

# Local SQL Server usually has a self-signed certificate.
HEYGEN_MSSQL_ENCRYPT=yes
HEYGEN_MSSQL_TRUST_CERT=yes

# Folder ON THE SQL SERVER MACHINE for .bak files taken before any rollback.
HEYGEN_MSSQL_BACKUP_DIR=C:\SQLBackups\Heygen

# Web port (the existing portfolio app uses 8501).
HEYGEN_PORT=8502
